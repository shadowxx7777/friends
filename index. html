<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>رسالة إلك</title>
<link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{
  color-scheme:dark;
  --bg:#1b1233; --ink:#3b2a5a; --paper:#fff4f0; --env:#c7b3ff; --env2:#a98cf0; --teal:#6fe3c1; --muted:#a79bc4;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:var(--bg);font-family:"Aref Ruqaa",Georgia,serif;overflow:hidden}
.stage{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:26px;text-align:center}
.hint{color:var(--muted);font-size:22px}
.env{position:relative;width:min(300px,78vw);aspect-ratio:3/2;cursor:pointer;border:0;background:none;padding:0;perspective:800px;animation:bob 2.6s ease-in-out infinite}
.env:focus-visible{outline:3px solid var(--teal);outline-offset:8px}
@keyframes bob{50%{transform:translateY(-8px)}}
.env .body{position:absolute;inset:0;background:var(--env);border-radius:8px;box-shadow:0 14px 40px rgba(0,0,0,.45)}
.env .left,.env .right{position:absolute;inset:0;background:var(--env2)}
.env .left{clip-path:polygon(0 0,52% 52%,0 100%)}
.env .right{clip-path:polygon(100% 0,48% 52%,100% 100%)}
.env .bottom{position:absolute;inset:0;background:#9a7de0;clip-path:polygon(0 100%,50% 46%,100% 100%)}
.env .flap{position:absolute;left:0;top:0;width:100%;height:58%;background:#dccfff;clip-path:polygon(0 0,100% 0,50% 100%);transform-origin:top;transition:transform .6s ease,z-index 0s .3s;z-index:3}
.env .seal{position:absolute;left:50%;top:48%;transform:translate(-50%,-50%);z-index:4;transition:opacity .3s}
.env.open{animation:none}
.env.open .flap{transform:rotateX(180deg);z-index:0}
.env.open .seal{opacity:0}
.env .mini{position:absolute;left:8%;right:8%;top:8%;bottom:12%;background:var(--paper);border-radius:4px;transition:transform .6s .3s;z-index:1}
.env.open .mini{transform:translateY(-34%)}

.overlay{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(27,18,51,.86);z-index:10;padding:20px}
.overlay.show{display:flex}
.card{width:min(420px,100%);background:var(--paper);color:var(--ink);border-radius:14px;padding:34px 24px 28px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,.6);animation:rise .6s ease-out}
@keyframes rise{from{transform:translateY(60px) scale(.9);opacity:0}to{transform:none;opacity:1}}
.card h1{font-size:clamp(26px,6vw,34px);margin:0 0 8px;line-height:1.5}
.card p{margin:0 0 24px;font-size:20px;opacity:.8}
.row{display:flex;gap:16px;justify-content:center;align-items:center;min-height:56px}
.btn{font:inherit;font-size:22px;border:0;border-radius:999px;padding:12px 34px;cursor:pointer}
.yes{background:#ff7a59;color:#fff}
.no{background:#d8d0ec;color:var(--ink);touch-action:none}
.no.fly{position:fixed;transition:left .25s ease,top .25s ease;z-index:20}
.btn:focus-visible{outline:3px solid var(--teal);outline-offset:3px}
.win{display:none}
.note{min-height:34px;margin:0 0 14px;font-size:22px;font-weight:700;color:#c2410c;line-height:1.5}
.win h1{font-size:clamp(28px,7vw,40px)}
.card.done .ask{display:none}
.card.done .win{display:block}
.fx{position:fixed;bottom:-50px;z-index:30;pointer-events:none;animation:up linear forwards}
@keyframes up{to{transform:translateY(-115vh) rotate(var(--r))}}
.fx svg{display:block;width:100%;height:auto}
.credit{position:fixed;left:14px;bottom:calc(10px + env(safe-area-inset-bottom,0px));z-index:40;pointer-events:none;color:var(--muted);font-size:16px;opacity:.8;direction:ltr}
@media (prefers-reduced-motion:reduce){.env,.card{animation:none}.fx{animation-duration:3s!important}}
</style>
</head>
